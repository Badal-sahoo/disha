# Vite only exposes variables prefixed VITE_ to the browser.
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# --- Basemap ---------------------------------------------------------------
# Optional. Leave BOTH unset and the map uses OpenStreetMap standard tiles:
# no key, no signup, zoom 19. That is the default in shared/utils/basemap.js.
#
# Set them together -- a provider's tiles and its required credit are a pair.
#
#   CARTO Voyager (what this project used to use). Their keyless CDN now
#   stamps "API KEY REQUIRED" across every tile. Get a key and check the
#   current free allowance at https://carto.com/basemaps/apikey
#     VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png?api_key=YOUR_KEY
#     VITE_MAP_ATTRIBUTION=<a href="https://www.openstreetmap.org/copyright">&copy; OpenStreetMap</a> contributors, <a href="https://carto.com/attributions">&copy; CARTO</a>
#
#   MapTiler. Free tier, needs a key: https://cloud.maptiler.com/account/keys/
#     VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}@2x.png?key=YOUR_KEY
#     VITE_MAP_ATTRIBUTION=<a href="https://www.maptiler.com/copyright/">&copy; MapTiler</a>, <a href="https://www.openstreetmap.org/copyright">&copy; OpenStreetMap</a> contributors
#
# The @2x on the keyed URLs asks for retina tiles -- sharper labels on a
# laptop or a projector. Plain OpenStreetMap has no @2x equivalent.
# VITE_MAP_TILE_URL=
# VITE_MAP_ATTRIBUTION=

# Opening map view -- Puri / Konark, Odisha.
VITE_MAP_CENTER_LAT=19.8135
VITE_MAP_CENTER_LON=85.8312
VITE_MAP_ZOOM=11
