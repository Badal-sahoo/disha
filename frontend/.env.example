# Vite only exposes variables prefixed VITE_ to the browser.
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# MapLibre needs a style URL. demotiles is keyless and works offline-ish;
# swap for a MapTiler/Protomaps style when you have a key.
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Opening map view -- Puri / Konark, Odisha.
VITE_MAP_CENTER_LAT=19.8135
VITE_MAP_CENTER_LON=85.8312
VITE_MAP_ZOOM=10
