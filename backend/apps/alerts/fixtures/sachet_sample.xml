<?xml version="1.0" encoding="UTF-8"?>
<!--
  Demo-safe CAP fixture. alerts.services.poll_feed() reads this file instead of
  the live SACHET feed whenever settings.USE_ALERT_FIXTURE is True, or whenever
  the network call fails. If the government feed is slow or down on
  presentation day, nothing on stage changes.

  The polygon below is a coarse box over the Puri / Konark stretch of the
  Odisha coast, matching the cyclone scenario in the benchmark simulator.
  CAP writes polygon points as "lat,lon" pairs, LAT FIRST. Keep that order.
-->
<alert xmlns="urn:oasis:names:tc:emergency:cap:1.2">
  <identifier>NDMA-SACHET-FIXTURE-0001</identifier>
  <sender>sachet@ndma.gov.in</sender>
  <sent>2026-08-26T05:30:00+05:30</sent>
  <status>Actual</status>
  <msgType>Alert</msgType>
  <scope>Public</scope>
  <info>
    <language>en-IN</language>
    <category>Met</category>
    <event>Cyclone Warning</event>
    <urgency>Immediate</urgency>
    <severity>Extreme</severity>
    <certainty>Observed</certainty>
    <expires>2026-08-26T17:30:00+05:30</expires>
    <senderName>India Meteorological Department</senderName>
    <headline>Severe cyclonic storm approaching Odisha coast</headline>
    <description>Landfall expected within 6 hours between Puri and Konark.
      Wind speeds 120-140 kmph. Storm surge up to 2 m above astronomical tide.</description>
    <instruction>Move to the nearest cyclone shelter. Do not stay in kutcha houses.</instruction>
    <area>
      <areaDesc>Puri and Konark coastal belt, Odisha</areaDesc>
      <polygon>19.75,85.75 19.75,86.05 19.95,86.05 19.95,85.75 19.75,85.75</polygon>
    </area>
  </info>
</alert>
