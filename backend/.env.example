# ---------------------------------------------------------------------------
# PS-05 backend environment. Copy to .env and fill the blanks.
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=qwertyuio
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres -- fill these three in.
DB_NAME=disha
DB_USER=subhasisjena
DB_PASSWORD=qtuyewqe122131
DB_HOST=localhost
DB_PORT=5432

# Channels group layer.
REDIS_URL=redis://127.0.0.1:6379/0

# The Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
ACCESS_TOKEN_MINUTES=60

# PS-05 tunables
# False (default) = the solver keeps a plan ready but an OPERATOR presses
# Dispatch. True = every incoming report commits the best plan by itself, which
# means the district is fully dispatched before anyone looks at the screen.
AUTO_DISPATCH=False
DISPATCH_MIN_INTERVAL_SEC=2
DISPATCH_HORIZON_MIN=120
USE_ROAD_GRAPH=True
USE_ALERT_FIXTURE=True
USE_WEBSOCKETS=True

# Shared secret the Android SMS gateway sends as X-Gateway-Secret.
SMS_GATEWAY_SECRET=change-me
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml

# TextBee SMS gateway (an Android phone forwarding received SMS).
# Get the key from the TextBee dashboard, and turn ON "Receive SMS" in the app.
# Then:  python manage.py poll_textbee
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev
